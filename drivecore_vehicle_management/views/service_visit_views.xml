<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drivecore_service_visit_search" model="ir.ui.view">
        <field name="name">drivecore.service.visit.search</field>
        <field name="model">drivecore.service.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="service_type_ids"/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'in_progress'])]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_drivecore_service_visit_list" model="ir.ui.view">
        <field name="name">drivecore.service.visit.list</field>
        <field name="model">drivecore.service.visit</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="visit_date"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="service_type_ids" widget="many2many_tags"/>
                <field name="odometer"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_drivecore_service_visit_form" model="ir.ui.view">
        <field name="name">drivecore.service.visit.form</field>
        <field name="model">drivecore.service.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Work" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Complete" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" string="Reset to Booked" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="visit_date"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id" domain="[('partner_id', '=', partner_id), ('company_id', '=', company_id)]"/>
                            <field name="odometer"/>
                            <field name="odometer_unit"/>
                            <field name="odometer_note" placeholder="Required when entering a lower reading..."/>
                        </group>
                        <group>
                            <field name="service_type_ids" widget="many2many_tags"/>
                            <field name="technician_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sale_order_id"/>
                            <field name="pos_order_id"/>
                            <field name="invoice_id"/>
                            <field name="odometer_record_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Request"><field name="customer_request"/></page>
                        <page string="Findings"><field name="technician_findings"/></page>
                        <page string="Work Performed"><field name="work_performed"/></page>
                        <page string="Recommendations"><field name="recommendations"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_drivecore_service_visit" model="ir.actions.act_window">
        <field name="name">Service Visits</field>
        <field name="res_model">drivecore.service.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drivecore_service_visit_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
