<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_drivecore_vehicle" model="ir.ui.view">
        <field name="name">res.partner.form.drivecore.vehicle</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_drivecore_vehicles" type="object" class="oe_stat_button" icon="fa-car"><field name="drivecore_vehicle_count" widget="statinfo" string="Vehicles"/></button></xpath>
            <xpath expr="//notebook" position="inside"><page string="Vehicles" name="drivecore_vehicles"><field name="drivecore_vehicle_ids"><list><field name="license_plate"/><field name="year"/><field name="make_id"/><field name="model_id"/><field name="vin"/><field name="current_odometer"/><field name="odometer_unit"/></list></field></page></xpath>
        </field>
    </record>
</odoo>
