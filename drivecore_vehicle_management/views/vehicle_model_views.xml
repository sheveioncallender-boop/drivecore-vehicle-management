<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drivecore_vehicle_model_list" model="ir.ui.view">
        <field name="name">drivecore.vehicle.model.list</field><field name="model">drivecore.vehicle.model</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="make_id"/><field name="name"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="view_drivecore_vehicle_model_form" model="ir.ui.view">
        <field name="name">drivecore.vehicle.model.form</field><field name="model">drivecore.vehicle.model</field>
        <field name="arch" type="xml"><form><sheet><group><field name="make_id"/><field name="name"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_drivecore_vehicle_model" model="ir.actions.act_window">
        <field name="name">Vehicle Models</field><field name="res_model">drivecore.vehicle.model</field><field name="view_mode">list,form</field>
    </record>
</odoo>
