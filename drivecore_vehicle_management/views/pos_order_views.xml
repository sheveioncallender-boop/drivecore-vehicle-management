<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_order_form_drivecore_vehicle" model="ir.ui.view">
        <field name="name">pos.order.form.drivecore.vehicle</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Customer &amp; Vehicle Details" col="4">
                    <group>
                        <field name="drivecore_customer_name"/>
                        <field name="drivecore_customer_phone"/>
                        <field name="drivecore_customer_address"/>
                        <field name="drivecore_vehicle_id"/>
                        <field name="drivecore_service_visit_id" readonly="1" invisible="not drivecore_service_visit_id"/>
                    </group>
                    <group>
                        <field name="drivecore_vehicle_year"/>
                        <field name="drivecore_vehicle_make"/>
                        <field name="drivecore_vehicle_model"/>
                        <field name="drivecore_number_plate"/>
                        <field name="drivecore_vin"/>
                        <field name="drivecore_odometer"/>
                        <field name="drivecore_odometer_unit"/>
                        <field name="drivecore_odometer_note"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
