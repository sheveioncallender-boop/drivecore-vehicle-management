<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_drivecore_vehicle" model="ir.ui.view">
        <field name="name">sale.order.form.drivecore.vehicle</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="DriveCore Vehicle &amp; Service" col="4">
                    <group>
                        <field name="drivecore_vehicle_id" domain="[('partner_id', '=', partner_id), ('company_id', '=', company_id)]"/>
                        <field name="drivecore_number_plate"/>
                        <field name="drivecore_vin"/>
                        <field name="drivecore_odometer"/>
                        <field name="drivecore_odometer_unit"/>
                        <field name="drivecore_odometer_note" placeholder="Required when entering a lower reading..."/>
                    </group>
                    <group>
                        <field name="drivecore_vehicle_year"/>
                        <field name="drivecore_vehicle_make"/>
                        <field name="drivecore_vehicle_model"/>
                        <field name="drivecore_service_type_id"/>
                        <field name="drivecore_service_visit_id" readonly="1" invisible="not drivecore_service_visit_id"/>
                    </group>
                    <group colspan="4">
                        <field name="drivecore_customer_request"/>
                        <field name="drivecore_technician_findings"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
