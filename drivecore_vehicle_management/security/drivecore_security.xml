<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_drivecore_vehicle" model="res.groups.privilege">
        <field name="name">DriveCore Vehicle Management</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_drivecore_vehicle_user" model="res.groups">
        <field name="name">Vehicle / Service User</field>
        <field name="comment">Can manage customer vehicles, odometer readings and service visits.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="drivecore_vehicle_management.res_groups_privilege_drivecore_vehicle"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_drivecore_vehicle_manager" model="res.groups">
        <field name="name">Vehicle / Service Manager</field>
        <field name="comment">Full DriveCore vehicle, service-history and configuration access.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="drivecore_vehicle_management.res_groups_privilege_drivecore_vehicle"/>
        <field name="implied_ids" eval="[(4, ref('drivecore_vehicle_management.group_drivecore_vehicle_user'))]"/>
    </record>

    <record id="rule_drivecore_vehicle_company" model="ir.rule">
        <field name="name">DriveCore vehicles by company</field>
        <field name="model_id" ref="model_drivecore_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_drivecore_odometer_company" model="ir.rule">
        <field name="name">DriveCore odometers by company</field>
        <field name="model_id" ref="model_drivecore_vehicle_odometer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_drivecore_service_visit_company" model="ir.rule">
        <field name="name">DriveCore service visits by company</field>
        <field name="model_id" ref="model_drivecore_service_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
